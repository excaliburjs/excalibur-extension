{
  "name": "Excalibur Dev Tools",
  "version": "1.0.8",
  "description": "Excalibur.js browser plugin for debugging your games",
  "manifest_version": 3,
  "devtools_page": "../devtools.html",
  "action": {
    "default_popup": "../popup.html",
    "default_title": "Excalibur Dev Tools",
    "default_icon": {
      "16": "../../res/icon-16.png",
      "32": "../../res/icon-32.png",
      "48": "../../res/icon-48.png",
      "64": "../../res/icon-64.png",
      "128": "../../res/icon-128.png"
    }
  },
  "commands": {
    "toggle-debug": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle Excalibur debug draw in the current tab"
    }
  },
  "permissions": ["tabs", "scripting"],
  "background": {
    "service_worker": "../background.ts",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost;object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["../excalibur-panel.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "../../res/icon-16.png",
    "32": "../../res/icon-32.png",
    "48": "../../res/icon-48.png",
    "64": "../../res/icon-64.png",
    "128": "../../res/icon-128.png"
  }
}
